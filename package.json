{
  "name": "hydration-buddy",
  "productName": "Hydration Buddy",
  "version": "1.3.0",
  "description": "A friendly hydration reminder with walking avatars",
  "main": "src/main.js",
  "author": "Hydration Buddy",
  "license": "MIT",
  "scripts": {
    "generate": "node scripts/generate-assets.js && node scripts/to-avif.js",
    "start": "electron .",
    "dist": "npm run generate && electron-builder --win",
    "smoke": "electron scripts/smoke-main.js",
    "test:click": "electron scripts/smoke-clicks.js",
    "sprites": "node scripts/to-avif.js",
    "check:sprites": "electron scripts/check-sprites.js",
    "icons": "node scripts/make-icons.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.hydrationbuddy.app",
    "productName": "Hydration Buddy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/assets/Water Timer Notification Icon.png",
      "!src/assets/main-reference{,/**}",
      "!src/assets/generated/*/{walkLeft,walkRight,stopLeftA,stopLeftB,turnFront,turnRight,startRight,wave,idle}.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hydration Buddy",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "differentialPackage": false
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ]
  }
}
